# Version Control
.git
.gitignore
.gitattributes

# IDE
.idea
.vscode
*.swp
*.swo
*~

# Environment
.env
.env.*
!.env.production

# Dependencies
node_modules
vendor

# Build artifacts
/public/hot
/public/storage
/storage/*.key

# Testing
.phpunit.result.cache
phpunit.xml
tests
coverage

# Documentation
*.md
!README.md
docs

# CI/CD
.github
.gitlab-ci.yml
.travis.yml

# Docker
docker-compose.yml
docker-compose.*.yml
!docker-compose.production.yml
Dockerfile
!docker/app/Dockerfile

# Logs
*.log
storage/logs/*

# Cache
bootstrap/cache/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*

# Temporary files
tmp
temp
*.tmp
