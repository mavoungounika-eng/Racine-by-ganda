# ============================================
# RACINE POS — Configuration
# ============================================

# --- App ---
VITE_APP_NAME="Racine POS"

# --- API Backend ---
# Dev local: http://127.0.0.1:8000
# Production: https://racinebyganda.com
VITE_API_URL=http://127.0.0.1:8000
VITE_API_TIMEOUT=10000

# --- Reverb / WebSocket Stock Sync ---
# Copier depuis REVERB_APP_KEY dans .env backend
#
# Dev local:
#   VITE_REVERB_HOST=localhost
#   VITE_REVERB_PORT=8080
#   VITE_REVERB_SCHEME=http
#
# Production:
#   VITE_REVERB_HOST=racinebyganda.com
#   VITE_REVERB_PORT=443
#   VITE_REVERB_SCHEME=https
#
VITE_REVERB_APP_KEY=your-reverb-app-key-here
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# --- Paiements ---
# Copier depuis STRIPE_KEY dans .env backend (clé publique pk_live_...)
VITE_STRIPE_PUBLISHABLE_KEY=
