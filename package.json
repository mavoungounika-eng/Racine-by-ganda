{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "rm -f public/hot && vite",
        "watch": "vite build --watch",
        "start": "rm -f public/hot && concurrently --names \"Laravel,Vite\" --prefix-colors \"green,blue\" \"php artisan serve\" \"vite build --watch\""
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.3",
        "autoprefixer": "^10.4.20",
        "concurrently": "^9.0.1",
        "cypress": "^15.9.0",
        "laravel-vite-plugin": "^2.0.0",
        "postcss": "^8.4.47",
        "vite": "^7.0.0"
    },
    "dependencies": {
        "@popperjs/core": "^2.11.8",
        "axios": "^1.11.0",
        "bootstrap": "^5.3.8",
        "laravel-echo": "^2.3.1",
        "pusher-js": "^8.4.0",
        "sass": "^1.94.2",
        "vue": "^3.5.26"
    }
}
