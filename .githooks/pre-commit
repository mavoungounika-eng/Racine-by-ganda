#!/bin/bash

# Pre-commit hook for auth security
# Prevents commits that violate auth architecture
# 
# INSTALLATION:
# chmod +x .githooks/pre-commit
# git config core.hooksPath .githooks

echo "🔒 Running auth security checks..."

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

VIOLATIONS=0

# Get staged PHP files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.php$')

if [ -z "$STAGED_FILES" ]; then
    echo "✅ No PHP files to check"
    exit 0
fi

# CHECK 1: No Auth::user()->role in controllers
echo "Checking for forbidden Auth::user()->role patterns..."
for FILE in $STAGED_FILES; do
    if echo "$FILE" | grep -q "app/Http/Controllers"; then
        if grep -n "Auth::user()->role" "$FILE"; then
            echo -e "${RED}❌ BLOCKED: Direct role access in $FILE${NC}"
            echo "   Use: UserContextResolver::getFromSession()"
            VIOLATIONS=$((VIOLATIONS + 1))
        fi
        
        if grep -n "Auth::user()->role_id" "$FILE"; then
            echo -e "${RED}❌ BLOCKED: Direct role_id access in $FILE${NC}"
            echo "   Use: UserContextResolver::getFromSession()"
            VIOLATIONS=$((VIOLATIONS + 1))
        fi
    fi
done

# CHECK 2: Verify route middleware (if routes modified)
if echo "$STAGED_FILES" | grep -q "routes/"; then
    echo "Checking route middleware..."
    
    # This requires Laravel to be bootable
    if command -v php &> /dev/null && [ -f artisan ]; then
        php artisan route:list --json > /tmp/routes_check.json 2>/dev/null
        
        if [ -f /tmp/routes_check.json ]; then
            INVALID=$(jq -r '.[] | select(.middleware | type == "array") | select(.middleware | contains(["auth"]) and (contains(["ensure"]) | not)) | .uri' /tmp/routes_check.json 2>/dev/null)
            
            if [ ! -z "$INVALID" ]; then
                echo -e "${RED}❌ BLOCKED: Routes with 'auth' must use 'ensure'${NC}"
                echo "$INVALID"
                VIOLATIONS=$((VIOLATIONS + 1))
            fi
        fi
    fi
fi

# CHECK 3: No manual auth_version modification
echo "Checking for manual auth_version modifications..."
for FILE in $STAGED_FILES; do
    if grep -n "auth_version\s*=" "$FILE" | grep -v "auth_version++\|auth_version--\|increment('auth_version')\|decrement('auth_version')"; then
        echo -e "${YELLOW}⚠️  WARNING: Manual auth_version modification in $FILE${NC}"
        echo "   Use: \$user->increment('auth_version')"
        # Don't block, just warn
    fi
done

# Final verdict
if [ $VIOLATIONS -gt 0 ]; then
    echo ""
    echo -e "${RED}❌ COMMIT BLOCKED: $VIOLATIONS auth security violation(s)${NC}"
    echo ""
    echo "Fix the issues above or use:"
    echo "  git commit --no-verify  (NOT RECOMMENDED)"
    exit 1
fi

echo -e "${GREEN}✅ Auth security checks passed${NC}"
exit 0
