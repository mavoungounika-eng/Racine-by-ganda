APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Reverse proxy IPs to trust for X-Forwarded-For (nginx, load balancer)
# Use '*' to trust all proxies, or comma-separated IPs: 10.0.0.1,10.0.0.2
TRUSTED_PROXIES=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# COMPANY INFORMATION (REQUIRED FOR PRODUCTION)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# These values are used in legal pages (CGV, privacy policy, contact).
# MUST be filled before production deployment.
#
COMPANY_NAME="RACINE BY GANDA"
# Pays et ville du siège social (juridiction OHADA)
COMPANY_COUNTRY="République du Congo"
COMPANY_CITY="Pointe-Noire"
# RCCM number (Registre du Commerce et du Crédit Mobilier — OHADA, e.g., "RCCM CG-PNR-01-2026-B12-00001")
COMPANY_RCCM=
# Legal address (siège social)
COMPANY_ADDRESS=
# Support phone (international format recommended: +XXX X XX XX XX XX)
COMPANY_PHONE=
# Share capital in euros (numeric value, e.g., 10000 for 10 000 €)
COMPANY_CAPITAL=
# Contact emails
COMPANY_EMAIL=contact@racinebyganda.com
COMPANY_SUPPORT_EMAIL=support@racinebyganda.com
COMPANY_DPO_EMAIL=dpo@racinebyganda.com
# CEO / Legal representative
COMPANY_CEO="Amira Ganda"
# VAT number (if applicable)
COMPANY_VAT_NUMBER=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=contact@racinebyganda.com
MAIL_FROM_NAME="RACINE BY GANDA"

# Company Information
COMPANY_NAME="Votre Entreprise"
COMPANY_EMAIL=contact@votre-domaine.com
COMPANY_PHONE="+XXX XXXXXXXXX"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Stripe Payment Configuration
STRIPE_ENABLED=false
STRIPE_PUBLIC_KEY=pk_test_your_public_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_CURRENCY=XAF

# POSSync / Device JWT
JWT_SECRET=
JWT_ALGO=HS256
POS_JWT_TTL=604800
POS_ADMIN_EMAIL=admin@racine-by-ganda.com

# ============================================
# IA DÉCISIONNELLE - GOUVERNANCE
# ============================================

# Activation globale
AI_DECISIONAL_ENABLED=true

# Modules activables/désactivables
AI_MODULE_CHURN_PREDICTION=true
AI_MODULE_CREATOR_SCORING=true
AI_MODULE_RECOMMENDATION=true
AI_MODULE_PRODUCT_PERFORMANCE=false
AI_MODULE_STOCK_PREDICTION=false
AI_MODULE_ANOMALY_DETECTION=false
AI_MODULE_CONVERSION_OPT=false

# Seuils configurables
AI_STOCK_CRITICAL_DAYS=7
AI_STOCK_WARNING_DAYS=14
AI_CREATOR_PROCESSING_MAX=3
AI_CREATOR_RETURN_RATE_MAX=15
AI_CREATOR_DISPUTE_RATE_MAX=5
AI_PRODUCT_MIN_SCORE=40
AI_PRODUCT_ROTATION_MIN=0.5
AI_SALES_ANOMALY_DROP=50
AI_CONVERSION_RATE_MIN=2
AI_CHURN_RISK_THRESHOLD=0.7

# Logging
AI_LOGGING_ENABLED=true

# Alertes
AI_ALERTS_ENABLED=true
AI_ALERT_CRITICAL_EMAILS=""
AI_ALERT_WARNING_EMAILS=""

# Performance
AI_CACHE_ENABLED=true
AI_CACHE_TTL=3600
AI_QUEUE=ai-processing

# ============================================
# PHASE 3: MONITORING & QUEUE PROTECTION
# ============================================

# Sentry Error Tracking
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT="${APP_ENV}"
SENTRY_RELEASE=
SENTRY_SEND_DEFAULT_PII=false
SENTRY_ENABLE_LOGS=false

# Queue Protection - Circuit Breaker
QUEUE_CIRCUIT_BREAKER_ENABLED=true
QUEUE_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
QUEUE_CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2
QUEUE_CIRCUIT_BREAKER_TIMEOUT=60
QUEUE_CIRCUIT_BREAKER_TTL=3600

# Queue Protection - Rate Limiting
QUEUE_RATE_LIMIT_ENABLED=true
QUEUE_RATE_LIMIT_WEBHOOKS_MAX=100
QUEUE_RATE_LIMIT_WEBHOOKS_WINDOW=60
QUEUE_RATE_LIMIT_EMAILS_MAX=50
QUEUE_RATE_LIMIT_EMAILS_WINDOW=60
QUEUE_RATE_LIMIT_NOTIFICATIONS_MAX=200
QUEUE_RATE_LIMIT_NOTIFICATIONS_WINDOW=60

# Queue Monitoring
QUEUE_MONITOR_ENABLED=true
QUEUE_MONITOR_SIZE_WARNING=500
QUEUE_MONITOR_SIZE_CRITICAL=1000
QUEUE_MONITOR_PROCESSING_TIME_WARNING=5.0
QUEUE_MONITOR_PROCESSING_TIME_CRITICAL=10.0
QUEUE_MONITOR_FAILURE_RATE_WARNING=0.05
QUEUE_MONITOR_FAILURE_RATE_CRITICAL=0.10

# Alert System - Slack
SLACK_WEBHOOK_URL=
SLACK_ALERT_CHANNEL="#alerts"
SLACK_ALERT_USERNAME="RACINE Monitoring"

# Alert System - Email
ALERT_EMAIL_RECIPIENTS=
ALERTS_ENABLED=true

# Alert Thresholds
ALERT_QUEUE_SIZE_WARNING=500
ALERT_QUEUE_SIZE_CRITICAL=1000
ALERT_PROCESSING_TIME_WARNING=5.0
ALERT_PROCESSING_TIME_CRITICAL=10.0
ALERT_FAILURE_RATE_WARNING=0.05
ALERT_FAILURE_RATE_CRITICAL=0.10
ALERT_ERROR_RATE_WARNING=0.01
ALERT_ERROR_RATE_CRITICAL=0.05

# ===============================
# GOOGLE RECAPTCHA V3
# ===============================
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_THRESHOLD=0.5
RECAPTCHA_SKIP_FOR_TESTING=false

# ── Broadcasting — Laravel Reverb ─────────────────────────────────────────
BROADCAST_CONNECTION=reverb

# Credentials Reverb (générer avec: php artisan reverb:install)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Client public (Nginx/SSL: host=domain.com port=443 scheme=https)
# Dev local: host=localhost port=8080 scheme=http
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Serveur interne (toujours 0.0.0.0:8080 — Nginx proxie vers ce port)
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Origines autorisées (production: https://yourdomain.com)
# Comma-separated list of allowed WebSocket origins (defaults to APP_URL if not set)
REVERB_ALLOWED_ORIGINS=

# VITE (frontend web — doit correspondre à REVERB_APP_KEY)
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Sanctum API token expiration in minutes (10080 = 7 days, null = never expires)
SANCTUM_TOKEN_EXPIRATION=10080

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
AI_DRIVER=openai
AI_MODEL=gpt-4o
AI_TIMEOUT=30

# ===============================
# EXCHANGE RATE API
# ===============================
# Obtenir sur https://www.exchangerate-api.com (free tier disponible)
EXCHANGE_RATE_API_KEY=

# ===============================
# MONETBIL (Mobile Money XAF)
# ===============================
# URLs à remplacer par le vrai domaine en production
MONETBIL_SERVICE_KEY=
MONETBIL_SERVICE_SECRET=
MONETBIL_NOTIFY_URL=https://votre-domaine.com/payments/monetbil/notify
MONETBIL_RETURN_URL=https://votre-domaine.com/checkout/success

# ===============================
# SHIPPING COSTS (XAF)
# ===============================
SHIPPING_HOME_DELIVERY_COST=2000
